<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Vendored WinFsp.Native build carrying the async GetFileSecurityByName /
         GetDirInfoByName API (source: github.com/hooyao/winfsp-native, branch
         feat/async-security-dirinfo-callbacks). Self-contained so CI builds without
         the sibling repo. Remove this source + the local-packages/ folder and bump
         the WinFsp.Native version in Directory.Packages.props once it's on nuget.org. -->
    <add key="local-winfsp" value="local-packages" />
  </packageSources>
</configuration>
