<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DokanSlowReadRepro</AssemblyName>
    <!-- DokanNet targets net10.0 among others; suppress the platform-compat noise. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the local dokan-dotnet source (DokanNet 2.3.0.4) directly, so we do not
         depend on a published NuGet. Requires the Dokany 2.x driver installed on the machine. -->
    <ProjectReference Include="Q:\MyProjects\zipdrive-source\dokan-dotnet\DokanNet\DokanNet.csproj" />
  </ItemGroup>

</Project>
