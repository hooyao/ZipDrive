<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SlowReadRepro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same WinFsp binding + version ZipDrive uses; already in the global NuGet cache. -->
    <PackageReference Include="WinFsp.Native" Version="0.1.3-pre.3" />
  </ItemGroup>

</Project>
