<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SlowReadRepro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same WinFsp binding + version ZipDrive uses. Version comes from the repo-root
         Directory.Packages.props (Central Package Management), so no Version attribute here. -->
    <PackageReference Include="WinFsp.Native" />
  </ItemGroup>

</Project>
